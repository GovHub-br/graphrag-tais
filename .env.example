# ------------------------------------------------------------------ #
# Qdrant (vector store)
# ------------------------------------------------------------------ #
QDRANT_HOST=qdrant
QDRANT_PORT=6333
QDRANT_API_KEY=
QDRANT_COLLECTION=documents
QDRANT_GRPC=false
QDRANT_EMBEDDING_DIM=768
QDRANT_SIMILARITY=cosine
QDRANT_TIMEOUT=30
QDRANT_USE_SPARSE=true
QDRANT_SPARSE_MODEL=Qdrant/bm25

# ------------------------------------------------------------------ #
# Neo4j (knowledge graph + vector index)
# ------------------------------------------------------------------ #
NEO4J_URL=bolt://neo4j:7687
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=password123
NEO4J_DATABASE=neo4j
NEO4J_INDEX=document-embeddings
NEO4J_NODE_LABEL=Document
NEO4J_EMBEDDING_DIM=768
NEO4J_SIMILARITY=cosine

# ------------------------------------------------------------------ #
# Ollama (embeddings + generation)
# ------------------------------------------------------------------ #
OLLAMA_URL=http://host.docker.internal:11434
OLLAMA_API_KEY=
OLLAMA_EMBED_MODEL=nomic-embed-text
OLLAMA_CHAT_MODEL=llama3.1
OLLAMA_TIMEOUT=120
OLLAMA_NUM_PREDICT=4096
OLLAMA_TEMPERATURE=0.1
OLLAMA_TOP_P=0.9
OLLAMA_TOP_K=40
OLLAMA_REPEAT_PENALTY=1.1
OLLAMA_REPEAT_LAST_N=64
OLLAMA_STOP_SEQUENCES=

# ------------------------------------------------------------------ #
# OpenAI (LLM da geração de SQL na query)
# ------------------------------------------------------------------ #
# Só a GERAÇÃO de SQL usa a OpenAI; os embeddings da query seguem on-prem
# (Ollama gte-qwen2 + BM25), iguais aos da ingestão. Só a pergunta e os
# metadados do schema saem para a nuvem — nunca as linhas do banco.
OPENAI_API_KEY=
OPENAI_CHAT_MODEL=gpt-4o
OPENAI_TEMPERATURE=0.1
OPENAI_MAX_TOKENS=2048
OPENAI_TIMEOUT=60

# ------------------------------------------------------------------ #
# Redis (memory manager para loops entre componentes Haystack)
# ------------------------------------------------------------------ #
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=redis_password
REDIS_DB=0

# ------------------------------------------------------------------ #
# OpenMetadata (fonte de metadados para a ingestão do grafo)
# ------------------------------------------------------------------ #
# URL da instância, sem /api/v1 no final.
OM_HOST=
OM_API_PATH=/api/v1

# JWT/PAT com permissão de leitura nas tabelas do escopo. Não versionar o valor real.
OM_JWT_TOKEN=
OM_EXPECTED_VERSION=1.12.1

# Escopo estável da ingestão (ADR-0008).
OM_SCOPE_ID=mcid
OM_SERVICE=Cidades
OM_DATABASE=cidades

# FQNs dos schemas separados por vírgula.
# Ex.: Cidades.cidades.empreendimento_far,Cidades.cidades.entidades_fds
OM_SCHEMAS=Cidades.cidades.conjuntura_bronze,Cidades.cidades.conjuntura_gold,Cidades.cidades.conjuntura_silver,Cidades.cidades.empreendimento_far,Cidades.cidades.entidades_fds

# Adapter opcional das relações semânticas publicadas em Custom Properties.
OM_RELATIONSHIP_ADAPTER=mcid_markdown_v1
OM_SEMANTIC_RELATIONSHIPS_PROPERTY=mcidSemanticRelationships
OM_RELATED_TABLES_PROPERTY=mcidRelatedTables
OM_REQUIRE_DOCUMENTED_TABLES=true
OM_CARD_SCHEMA_VERSION=v1
# Perfil de desenvolvimento; não representa escolha de produção.
OM_EMBEDDING_PROFILE=dev-nomic-embed-text__qdrant-bm25-v1

# Paginação, timeout por request e retries para timeout/429/5xx.
OM_PAGE_SIZE=100
OM_TIMEOUT=60
OM_MAX_RETRIES=3

# ------------------------------------------------------------------ #
# Ingest / batching / splitting
# ------------------------------------------------------------------ #
INGEST_BATCH_DOCS=200
EMBED_BATCH_SIZE=32
WRITE_BATCH_SIZE=128
SPLIT_BY=word
SPLIT_LENGTH=250
SPLIT_OVERLAP=37

# ------------------------------------------------------------------ #
# Open WebUI
# ------------------------------------------------------------------ #
OPEN_WEBUI_PORT=3000

# ------------------------------------------------------------------ #
# Anlytics Database
# ------------------------------------------------------------------ #
ANALYTICS_DB_HOST=analytics-db
ANALYTICS_DB_PORT=5432
ANALYTICS_DB_NAME=analytics
ANALYTICS_DB_USER=analytics_user
ANALYTICS_DB_PASSWORD=analytics_password

POSTGRES_MCP_PORT=8001
