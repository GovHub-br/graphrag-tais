# ------------------------------------------------------------------ #
# Qdrant (vector store)
# ------------------------------------------------------------------ #
QDRANT_HOST=qdrant
QDRANT_PORT=6333
QDRANT_API_KEY=
QDRANT_COLLECTION=documents
QDRANT_GRPC=false
QDRANT_EMBEDDING_DIM=768
QDRANT_SIMILARITY=cosine
QDRANT_TIMEOUT=30
QDRANT_USE_SPARSE=true
QDRANT_SPARSE_MODEL=Qdrant/bm25

# ------------------------------------------------------------------ #
# Neo4j (knowledge graph + vector index)
# ------------------------------------------------------------------ #
NEO4J_URL=bolt://neo4j:7687
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=password123
NEO4J_DATABASE=neo4j
NEO4J_INDEX=document-embeddings
NEO4J_NODE_LABEL=Document
NEO4J_EMBEDDING_DIM=768
NEO4J_SIMILARITY=cosine

# ------------------------------------------------------------------ #
# Ollama (embeddings + generation)
# ------------------------------------------------------------------ #
OLLAMA_URL=http://host.docker.internal:11434
OLLAMA_API_KEY=
OLLAMA_EMBED_MODEL=nomic-embed-text
OLLAMA_CHAT_MODEL=llama3.1
OLLAMA_TIMEOUT=120
OLLAMA_NUM_PREDICT=4096
OLLAMA_TEMPERATURE=0.1
OLLAMA_TOP_P=0.9
OLLAMA_TOP_K=40
OLLAMA_REPEAT_PENALTY=1.1
OLLAMA_REPEAT_LAST_N=64
OLLAMA_STOP_SEQUENCES=

# ------------------------------------------------------------------ #
# OpenAI (LLM da geração de SQL na query)
# ------------------------------------------------------------------ #
# Só a GERAÇÃO de SQL usa a OpenAI; os embeddings da query seguem on-prem
# (Ollama gte-qwen2 + BM25), iguais aos da ingestão. Só a pergunta e os
# metadados do schema saem para a nuvem — nunca as linhas do banco.
OPENAI_API_KEY=
OPENAI_CHAT_MODEL=gpt-4o
OPENAI_TEMPERATURE=0.1
OPENAI_MAX_TOKENS=2048
OPENAI_TIMEOUT=60

# ------------------------------------------------------------------ #
# Camada de entrega (ADR-0013): execução via postgres-mcp + gráfico
# ------------------------------------------------------------------ #
# O postgres-mcp já roda no compose (read-only). Dentro da rede: postgres-mcp:8000.
POSTGRES_MCP_URL=http://postgres-mcp:8000/sse
AGENT_MAX_STEPS=6
MAX_EXEC_ROWS=1000
CHART_DPI=120
CHART_MAX_CATEGORIES=20
# Explicação do resultado (ADR-0010 item c): 1 parágrafo acima do gráfico, sobre
# o que o SQL trouxe. O LLM lê um RESUMO estatístico, nunca as linhas cruas.
RESULT_SUMMARY_ENABLED=true
RESULT_SUMMARY_MAX_TOKENS=260
RESULT_SUMMARY_TOP_N=5

# ------------------------------------------------------------------ #
# Relatório .docx (ADR-0010): resposta Markdown → Word editável + MinIO
# ------------------------------------------------------------------ #
REPORT_ENABLED=true
REPORT_OUTPUT_DIR=/app/reports
REPORT_TITLE=Relatório de Consulta
REPORT_KICKER=GovHub · Assistente de Dados
REPORT_FOOTER=GovHub · Assistente de Dados · Metodologia GovHub
REPORT_PRESIGN_EXPIRY=604800
# MINIO_ENDPOINT: interno (rede do compose, upload). PUBLIC: host do navegador
# (assinatura do link). Se assinar com o host interno, o download quebra no browser.
MINIO_ENDPOINT=http://minio:9000
MINIO_PUBLIC_ENDPOINT=http://localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=relatorios
MINIO_REGION=us-east-1

# ------------------------------------------------------------------ #
# Persona 1 — modo Explorar (ADR-0014). Modelo `explore` no OpenWebUI.
# ------------------------------------------------------------------ #
# Só a pipeline `explore` lê estas variáveis. Cobertura > precisão: top_k maior
# e expansão ampla, ao contrário do tuning da Persona 2 logo abaixo.
EXPLORE_TOP_K=15
EXPLORE_MAX_TABLES=25
# Orçamento de colunas por card (medido em 19/08, ver eval/experiments):
# semente 10 / expansão 6 mantém prompt e latência do baseline e sobe o recall
# de coluna de 0,489 para 0,575. Ver o experimento antes de mexer.
EXPLORE_MAX_COLUMNS=10
EXPLORE_MAX_COLUMNS_EXPANSION=6
# Nomes das colunas podadas no card da tabela-semente (0 = desligado): custa
# ~10% de prompt e o ganho ainda não é mensurável pelas métricas de hoje.
EXPLORE_MAX_OMITTED_NAMES=0
EXPLORE_EXPAND_NEIGHBORS=true
EXPLORE_QUESTIONS_PER_TABLE=3
EXPLORE_MAX_LISTED_TABLES=12
EXPLORE_LLM_REORDER=true
# Amostra de dados reais na resposta do modo Explorar: executa o SQL de amostra,
# mostra as primeiras linhas no chat e publica o CSV (bucket `amostras`, link com
# validade curta). EXPLORE_SAMPLE_AUTOCORRECT=false economiza LLM: a amostra ainda
# sai (reconstruída do catálogo), só não preserva a intenção da consulta.
EXPLORE_EXECUTE_SAMPLE=true
EXPLORE_SAMPLE_ROWS=100
EXPLORE_SAMPLE_PREVIEW_ROWS=10
EXPLORE_SAMPLE_AUTOCORRECT=true
EXPLORE_SAMPLE_AGENT_STEPS=3
# Lacunas de escopo: {conceito na pergunta: o que responder}. É o que transforma
# "refine a pergunta" em recusa informativa. Sem cercas markdown, tudo em 1 linha.
# SCOPE_GAPS={"execução orçamentária": "Não tenho execução orçamentária (valor empenhado/liquidado/pago): esses dados estão em __dados_brutos, fora da ingestão. Tenho valor contratado e valor desembolsado por empreendimento.", "valor executado": "Não tenho valor executado. O que existe é valor contratado e desembolsado.", "rural": "Não tenho o MCMV rural (empreendimento_rural está fora da ingestão). Tenho FAR e Entidades/FDS."}
SCOPE_GAPS=

# ------------------------------------------------------------------ #
# Tuning do retrieval da Persona 2 (Fase 1/2). EXPANSION_MODE: evidence | all
# ------------------------------------------------------------------ #
EXPANSION_MODE=evidence
RETRIEVAL_POOL_SIZE=30
PRUNE_SEED_TABLE_MAX_COLS=25
PRUNE_EXPANSION_TABLE_MAX_COLS=6

# ------------------------------------------------------------------ #
# Redis (memory manager para loops entre componentes Haystack)
# ------------------------------------------------------------------ #
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=redis_password
REDIS_DB=0

# ------------------------------------------------------------------ #
# OpenMetadata (fonte de metadados para a ingestão do grafo)
# ------------------------------------------------------------------ #
# URL da instância, sem /api/v1 no final.
OM_HOST=
OM_API_PATH=/api/v1

# JWT/PAT com permissão de leitura nas tabelas do escopo. Não versionar o valor real.
OM_JWT_TOKEN=
OM_EXPECTED_VERSION=1.12.1

# Escopo estável da ingestão (ADR-0008).
OM_SCOPE_ID=mcid
OM_SERVICE=Cidades
OM_DATABASE=cidades

# FQNs dos schemas separados por vírgula.
# Ex.: Cidades.cidades.empreendimento_far,Cidades.cidades.entidades_fds
OM_SCHEMAS=Cidades.cidades.conjuntura_bronze,Cidades.cidades.conjuntura_gold,Cidades.cidades.conjuntura_silver,Cidades.cidades.empreendimento_far,Cidades.cidades.entidades_fds

# Adapter opcional das relações semânticas publicadas em Custom Properties.
OM_RELATIONSHIP_ADAPTER=mcid_markdown_v1
OM_SEMANTIC_RELATIONSHIPS_PROPERTY=mcidSemanticRelationships
OM_RELATED_TABLES_PROPERTY=mcidRelatedTables
OM_REQUIRE_DOCUMENTED_TABLES=true
OM_CARD_SCHEMA_VERSION=v1
# Perfil de desenvolvimento; não representa escolha de produção.
OM_EMBEDDING_PROFILE=dev-nomic-embed-text__qdrant-bm25-v1

# Paginação, timeout por request e retries para timeout/429/5xx.
OM_PAGE_SIZE=100
OM_TIMEOUT=60
OM_MAX_RETRIES=3

# ------------------------------------------------------------------ #
# Ingest / batching / splitting
# ------------------------------------------------------------------ #
INGEST_BATCH_DOCS=200
EMBED_BATCH_SIZE=32
WRITE_BATCH_SIZE=128
SPLIT_BY=word
SPLIT_LENGTH=250
SPLIT_OVERLAP=37

# ------------------------------------------------------------------ #
# Open WebUI
# ------------------------------------------------------------------ #
OPEN_WEBUI_PORT=3000

# ------------------------------------------------------------------ #
# Anlytics Database
# ------------------------------------------------------------------ #
ANALYTICS_DB_HOST=analytics-db
ANALYTICS_DB_PORT=5432
ANALYTICS_DB_NAME=analytics
ANALYTICS_DB_USER=analytics_user
ANALYTICS_DB_PASSWORD=analytics_password

POSTGRES_MCP_PORT=8001
