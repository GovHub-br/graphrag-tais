# ------------------------------------------------------------------ #
# Qdrant (vector store)
# ------------------------------------------------------------------ #
QDRANT_HOST=qdrant
QDRANT_PORT=6333
QDRANT_API_KEY=
QDRANT_COLLECTION=documents
QDRANT_GRPC=false
QDRANT_EMBEDDING_DIM=768
QDRANT_SIMILARITY=cosine
QDRANT_TIMEOUT=30
QDRANT_USE_SPARSE=true
QDRANT_SPARSE_MODEL=prithivida/Splade_PP_en_v1

# ------------------------------------------------------------------ #
# Neo4j (knowledge graph + vector index)
# ------------------------------------------------------------------ #
NEO4J_URL=bolt://neo4j:7687
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=password123
NEO4J_DATABASE=neo4j
NEO4J_INDEX=document-embeddings
NEO4J_NODE_LABEL=Document
NEO4J_EMBEDDING_DIM=768
NEO4J_SIMILARITY=cosine

# ------------------------------------------------------------------ #
# Ollama (embeddings + generation)
# ------------------------------------------------------------------ #
OLLAMA_URL=http://host.docker.internal:11434
OLLAMA_API_KEY=
OLLAMA_EMBED_MODEL=nomic-embed-text
OLLAMA_CHAT_MODEL=llama3.1
OLLAMA_TIMEOUT=120
OLLAMA_NUM_PREDICT=4096
OLLAMA_TEMPERATURE=0.1
OLLAMA_TOP_P=0.9
OLLAMA_TOP_K=40
OLLAMA_REPEAT_PENALTY=1.1
OLLAMA_REPEAT_LAST_N=64
OLLAMA_STOP_SEQUENCES=

# ------------------------------------------------------------------ #
# Redis (memory manager para loops entre componentes Haystack)
# ------------------------------------------------------------------ #
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=redis_password
REDIS_DB=0

# ------------------------------------------------------------------ #
# OpenMetadata (fonte de metadados para a ingestão do grafo)
# ------------------------------------------------------------------ #
OM_HOST=http://localhost:8585
OM_API_PATH=/api/v1
OM_JWT_TOKEN=
OM_PAGE_SIZE=100
OM_TIMEOUT=60

# ------------------------------------------------------------------ #
# Ingest / batching / splitting
# ------------------------------------------------------------------ #
INGEST_BATCH_DOCS=200
EMBED_BATCH_SIZE=32
WRITE_BATCH_SIZE=128
SPLIT_BY=word
SPLIT_LENGTH=250
SPLIT_OVERLAP=37

# ------------------------------------------------------------------ #
# Open WebUI
# ------------------------------------------------------------------ #
OPEN_WEBUI_PORT=3000
